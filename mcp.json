{
  "imports": [
    "claude-code"
  ],
  "mcpServers": {
    "bling": {
      "url": "https://mcp.dev.bling.com.br/mcp",
      "auth": "oauth",
      "oauth": {
        "grantType": "authorization_code",
        "clientId": "${BING_CLIENT_ID}",
        "clientSecret": "${BING_CLIENT_SECRET}",
        "redirectUri": "http://localhost:3000/callback"
      },
      "directTools": true,
      "idleTimeout": 10
    }
  }
}
